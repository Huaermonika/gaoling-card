  if (!themes[key]) return;
  themeKey.value = key;
  customAccent.value = '';
}
function setCustomAccent(c) { customAccent.value = c; }
function resetAccent() { customAccent.value = ''; }
function setFontSize(n) { fontSize.value = n; }
function themePreviewStyle(t) {
