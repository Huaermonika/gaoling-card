    opacity: 0;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }}
.fe-app .status-update{width: 100%;
  padding: 10px;
  margin-bottom: 10px;
  background: var(--accent);
