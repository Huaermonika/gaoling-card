/* ============ 状态面板 ============ */
function clsOf(s) {
  const map = {
    运行中: 'is-running', 已停止: 'is-stopped', 已冻结: 'is-frozen',
    正常运行: 'is-running', 未响应: 'is-stopped', 休眠: 'is-frozen',
  };
  return map[s] ?? '';
}
const awareClass = computed(() => clsOf(store.data.千鹤.意识状态));
const sysClass = computed(() => clsOf(store.data.千鹤.系统状态));
